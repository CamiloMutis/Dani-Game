    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[0]'
      value: 'FREDY: Hola DANI, feliz cumple.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[1]'
      value: 'DANI: Gracias, Fredy. Me alegra mucho verte!'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[2]'
      value: 'FREDY: Que Dios te bendiga siempre.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[3]'
      value: 'DANI: Es el mejor deseo que podria recibir. Gracias!'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[4]'
      value: 'FREDY: Y que te de sabiduria para tomar cada decision en tu vida.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[5]'
      value: 'DANI: Gracias de corazon. Me llega mucho tu mensaje.'
      objectReference: {fileID: 0}
