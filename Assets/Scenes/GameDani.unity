    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: DialogoPanel
      value: 
      objectReference: {fileID: 742528049}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: charsToPlaySound
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: nombreDeLaEscena
      value: Video1
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: cambiarDeEscenaAlFinal
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: reproducirVideoAlFinal
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: dialogoLineas.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[0]'
      value: "ANY: \xA1Feliz cumple, Dani! Espero que tambien hayas traido tus reflejos\u2026
        los vas a necesitar."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[1]'
      value: "DANI: \xBFReflejos? \xBFQue clase de regalo es ese?"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[2]'
      value: "ANY: Un aviso amistoso. Hay obstaculos, abismos\u2026 no todo se resuelve
        a golpes, \xBFsabes?"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[3]'
      value: "DANI: Ya me lo imagino\u2026 \xBFpero crees que no lo manejo?"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[4]'
      value: 'ANY: Por supuesto que si. Con tus habilidades de porrista sera pan
        comido.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[5]'
      value: "DANI: Entonces me toca brillar como nunca. \xA1A saltar con estilo!"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[6]'
      value: "ANY: Asi se dice. \xA1Vamos, campeona! Que tu cumple sea puro movimiento
        y cero caidas."
      objectReference: {fileID: 0}
    - target: {fileID: 7760291725988623279, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_Name
      value: AmyNCP
      objectReference: {fileID: 0}
    - target: {fileID: 9088791110383115213, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.x
      value: 4.04
      objectReference: {fileID: 0}
    - target: {fileID: 9088791110383115213, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.y
      value: 4.97
      objectReference: {fileID: 0}
