      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[0]'
      value: 'MUTIS: feliz cumple amor espero que te guste el juego y esta sorpresita.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[1]'
      value: "DANI: espera... \xBFeres tu? \xBFestas dentro del juego?."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[2]'
      value: 'MUTIS: jajaja sorpresa tu regalo soy yo en pixeles y vengo con nivel
        nuevo.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[3]'
      value: 'DANI: no lo puedo creer eres tan lindo asi.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[4]'
      value: 'MUTIS: gracias amor pero no te confies esto apenas empieza.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[5]'
      value: "DANI: \xBFya estoy en el nivel? se ve... peligroso."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[6]'
      value: 'MUTIS: oh si la parte dificil comienza ahora y no hay checkpoints.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[7]'
      value: "DANI: \xBFsin checkpoints...? noooo ."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[8]'
      value: 'MUTIS: si mueres toca empezar de cero asi que... cuidado mi amor.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[9]'
      value: 'DANI: bueno... lo hare por ti y por mi cumple jeje'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[10]'
      value: 'MUTIS: te amo incluso si caes 50 veces en la misma trampa <3.'
      objectReference: {fileID: 0}
