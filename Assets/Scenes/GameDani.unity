    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: dialogoLineas.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[0]'
      value: "KNUCKLES: \xA1Hey, Dani! Feliz cumple. Espero que estes lista para
        algo mas que pastel..."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[1]'
      value: "DANI: \xA1Gracias, Knuckles! \xBFAlgo me estas ocultando?"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[2]'
      value: 'KNUCKLES: No lo oculto, lo advierto. Hay enemigos mas adelante. No
        te dejaran pasar sin pelear.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[3]'
      value: "DANI: \xBFEnemigos? \xBFQue tipo?"
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[4]'
      value: "KNUCKLES: No importa el tipo. Solo importa que estas preparada. Tienes
        fuerza\u2026 usala."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[5]'
      value: 'DANI: Bueno, si hay que luchar, luchare. Estoy lista.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[6]'
      value: "KNUCKLES: Eso quiero oir. Vamos a romperles el camino. \xA1Suerte,
        Dani! Pero recuerda\u2026 los fuertes no dudan."
      objectReference: {fileID: 0}
    - target: {fileID: 4911232471217445842, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7760291725988623279, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_Name
      value: KnucklesNPC
      objectReference: {fileID: 0}
    - target: {fileID: 7760291725988623279, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
