      propertyPath: reproducirVideoAlFinal
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: dialogoLineas.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[0]'
      value: 'ANDREA: Feliz cumple monita. Tu reto de hoy es simple'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[1]'
      value: 'DANI: Jajaja, lo acepto! Que bueno que te acordaste.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[2]'
      value: 'ANDREA: Uno: comer pastel. Dos: reir hasta llorar.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[3]'
      value: 'DANI: Y el tres es el mas dificil, verdad?'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[4]'
      value: 'ANDREA: Tres: evitar que el pastel desaparezca misteriosamente antes
        de que llegues jajaja.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[5]'
      value: 'DANI: Jajajaja, ya voy para alla! Tranquila que lo salvare del misterio.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[6]'
      value: 'DANI: Jajajaja, ya voy para alla! Tranquila que lo salvare del misterio.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[7]'
      value: "DANI: \xBFsin checkpoints...? noooo ."
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[8]'
      value: 'MUTIS: si mueres toca empezar de cero asi que... cuidado mi amor.'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[9]'
      value: 'DANI: bueno... lo hare por ti y por mi cumple jeje'
      objectReference: {fileID: 0}
    - target: {fileID: 4882478454567850250, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: 'dialogoLineas.Array.data[10]'
      value: 'MUTIS: te amo incluso si caes 50 veces en la misma trampa <3.'
      objectReference: {fileID: 0}
    - target: {fileID: 7760291725988623279, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_Name
      value: AndreaNPC
      objectReference: {fileID: 0}
    - target: {fileID: 9088791110383115213, guid: dc095ade07bbafb4dae51873fb870ead, type: 3}
      propertyPath: m_SpriteTilingProperty.oldSize.x
      value: 3.48
